# The homeserver of one account on loopback, or the host's behind its private gate. Shipped disabled: the
# account enables it with `systemctl --user enable --now porelo-matrix-homeserver`. Its port and server
# name come from porelo/matrix/homeserver.conf under $XDG_CONFIG_HOME (%E, ~/.config by default) when
# set there, where the transport writes them. The image is filled in at build time from the FROM line of
# homeserver/Dockerfile, the one place it is pinned. In gate mode its Unix socket is private to this
# account; inner port 8009 has no listener, so no host TCP port reaches it.
[Unit]
Description=The Matrix homeserver Porelo's transport talks to, on loopback
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
RequiresMountsFor=%t/containers

[Service]
Environment=PORELO_MATRIX_PORT=8008
Environment=PORELO_MATRIX_INNER_PORT=8008
Environment=PORELO_MATRIX_SERVER_NAME=localhost
EnvironmentFile=-%E/porelo/matrix/homeserver.conf
Environment=PODMAN_SYSTEMD_UNIT=%n
# Makes the registration token once, the backup and gate directories, which must exist before their mounts,
# and the environment file before every start: empty, or in gate mode the homeserver's private socket.
ExecStartPre=/usr/libexec/porelo/transports/porelo-message-transport-matrix homeserver-token
# The shape podman's own quadlet generator gives a container unit, so a stop is a clean one. The container
# is named outside `porelo-`, which is Porelo's own: every container named so is a task to it. It is acted on
# by the id podman gave this unit, never by its name: a container somebody else named so is neither
# replaced nor removed - the start fails and says the name is taken. One of this unit's own, left by a
# crash, is removed by its id before the start.
ExecStartPre=-/usr/bin/podman rm -v -f -i --cidfile=%t/%N.cid
ExecStart=/usr/bin/podman run --rm -d --cidfile=%t/%N.cid --name matrix-homeserver \
    --sdnotify=conmon --cgroups=split \
    --pids-limit=512 \
    --memory=1g \
    --cpus=2 \
    -e TUWUNEL_SERVER_NAME=${PORELO_MATRIX_SERVER_NAME} \
    -e TUWUNEL_ADDRESS=0.0.0.0 -e TUWUNEL_PORT=8008 -e TUWUNEL_DATABASE_PATH=/data \
    -e TUWUNEL_DB_POOL_MAX_WORKERS=64 \
    -e TUWUNEL_DB_CACHE_CAPACITY_MB=256 \
    -e TUWUNEL_CACHE_CAPACITY_MODIFIER=0.5 \
    -e TUWUNEL_ROCKSDB_PARALLELISM_THREADS=2 \
    -e TUWUNEL_ALLOW_FEDERATION=false -e TUWUNEL_ALLOW_REGISTRATION=true \
    -e TUWUNEL_NEW_USER_DISPLAYNAME_SUFFIX= \
    -e TUWUNEL_REGISTRATION_TOKEN_FILE=/run/secrets/tokens/registration-token \
    -e TUWUNEL_DATABASE_BACKUP_PATH=/backup -e TUWUNEL_DATABASE_BACKUPS_TO_KEEP=48 \
    -e 'TUWUNEL_ADMIN_SIGNAL_EXECUTE=["server backup-database"]' \
    -v %E/porelo/matrix/tokens:/run/secrets/tokens:ro,Z \
    --env-file=%E/porelo/matrix/tls.env \
    -v porelo-matrix-homeserver:/data \
    -v %S/porelo/matrix/backups:/backup:Z \
    -v %t/porelo-matrix-gate:/gate:Z \
    -p 127.0.0.1:${PORELO_MATRIX_PORT}:${PORELO_MATRIX_INNER_PORT} \
    @IMAGE@
ExecStop=/usr/bin/podman rm -v -f -i --cidfile=%t/%N.cid
ExecStopPost=-/usr/bin/podman rm -v -f -i --cidfile=%t/%N.cid
KillMode=mixed
Delegate=yes
SyslogIdentifier=%N
Type=notify
NotifyAccess=all
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
