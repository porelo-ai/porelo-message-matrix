<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo-parent</artifactId>
        <version>0.2.1-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>org.fuin.porelo</groupId>
    <artifactId>porelo-message-matrix</artifactId>
    <version>0.5.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Porelo Message Matrix</name>
    <description>The Matrix transport: a project's room, where tasks talk</description>
    <url>https://github.com/porelo-ai/porelo-message-matrix/</url>

    <scm>
        <connection>scm:git:git://github.com/porelo-ai/porelo-message-matrix.git</connection>
        <developerConnection>scm:git:git@github.com:porelo-ai/porelo-message-matrix.git</developerConnection>
        <url>https://github.com/porelo-ai/porelo-message-matrix/</url>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/porelo-ai/porelo-message-matrix/issues</url>
    </issueManagement>

    <properties>
        <jspecify.version>1.0.1</jspecify.version>
        <assertj.version>3.27.7</assertj.version>
        <jackson.version>2.22.1</jackson.version>
        <main.class>org.fuin.porelo.message.matrix.Main</main.class>
        <transport.name>porelo-message-transport-matrix</transport.name>
        <!-- Named as porelo names its snapshots; CI sets the run and clears the local suffix. -->
        <porelo.snapshot.run>0</porelo.snapshot.run>
        <porelo.snapshot.suffix>+local.${maven.build.timestamp}</porelo.snapshot.suffix>
        <!-- The newest glibc and zlib symbol versions the native executable needs, measured with objdump -T;
             PackagesIT checks the packages against the executable built. -->
        <matrix.glibc.floor>2.34</matrix.glibc.floor>
        <matrix.zlib.floor>1.2.2</matrix.zlib.floor>
        <deb.version>0.5.1~snapshot.${porelo.snapshot.run}${porelo.snapshot.suffix}</deb.version>
        <rpm.release>snapshot.${porelo.snapshot.run}</rpm.release>
        <package.doc>/usr/share/doc/${transport.name}</package.doc>
        <homeserver.name>porelo-matrix-homeserver</homeserver.name>
        <homeserver.unit>${project.build.directory}/homeserver/${homeserver.name}.service</homeserver.unit>
        <!-- What the integration tests run under -Pnative. -->
        <transport.executable>${project.build.directory}/${transport.name}</transport.executable>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
            </plugin>
            <!-- The integration tests run against the real homeserver in podman, which every Porelo machine has. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- The shared code style: validate refuses misformatted Java, spotless:apply formats it. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The installed transport is a native executable, so it needs no Java at run time. -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <imageName>${transport.name}</imageName>
                            <mainClass>${main.class}</mainClass>
                            <buildArgs>
                                <!-- The baseline every x86-64 CPU has, as every Porelo executable: the default
                                     would ask for AVX2 and refuse to start on an older machine. -->
                                <buildArg>-march=x86-64</buildArg>
                                <!-- The one foreign call, prctl, that keeps the tokens from the account's other
                                     processes. -->
                                <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                            </buildArgs>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- The homeserver's unit, with the image the Dockerfile pins filled in. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>homeserver-unit</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>org.fuin.porelo.message.matrix.HomeserverUnit</mainClass>
                                    <classpathScope>test</classpathScope>
                                    <arguments>
                                        <argument>${project.basedir}/homeserver/porelo-matrix-homeserver.service</argument>
                                        <argument>${project.basedir}/homeserver/Dockerfile</argument>
                                        <argument>${homeserver.unit}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- The bill of what the executable is built from, shipped beside it. -->
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>makeBom</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <outputFormat>json</outputFormat>
                            <outputName>sbom.cdx</outputName>
                            <includeTestScope>false</includeTestScope>
                            <!-- The bill goes into the packages; nothing goes to Central, which the plugin
                                 would otherwise take as a reason to make none. -->
                            <skipNotDeployed>false</skipNotDeployed>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.vafer</groupId>
                        <artifactId>jdeb</artifactId>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>jdeb</goal>
                                </goals>
                                <configuration>
                                    <deb>${project.build.directory}/${transport.name}_${deb.version}_amd64.deb</deb>
                                    <snapshotExpand>false</snapshotExpand>
                                    <dataSet>
                                        <data>
                                            <src>${project.build.directory}/${transport.name}</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/libexec/porelo/transports</prefix>
                                                <user>root</user>
                                                <group>root</group>
                                                <filemode>755</filemode>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.build.directory}/sbom.cdx.json</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>${package.doc}</prefix>
                                                <user>root</user>
                                                <group>root</group>
                                                <filemode>644</filemode>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.basedir}/LICENSE</src>
                                            <dst>copyright</dst>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>${package.doc}</prefix>
                                                <user>root</user>
                                                <group>root</group>
                                                <filemode>644</filemode>
                                            </mapper>
                                        </data>
                                    </dataSet>
                                </configuration>
                            </execution>
                            <execution>
                                <id>homeserver-deb</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jdeb</goal>
                                </goals>
                                <configuration>
                                    <controlDir>${project.basedir}/src/deb/homeserver</controlDir>
                                    <deb>${project.build.directory}/${homeserver.name}_${deb.version}_all.deb</deb>
                                    <classifier>homeserver</classifier>
                                    <snapshotExpand>false</snapshotExpand>
                                    <dataSet>
                                        <data>
                                            <src>${homeserver.unit}</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/lib/systemd/user</prefix>
                                                <user>root</user>
                                                <group>root</group>
                                                <filemode>644</filemode>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.basedir}/LICENSE</src>
                                            <dst>copyright</dst>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/share/doc/${homeserver.name}</prefix>
                                                <user>root</user>
                                                <group>root</group>
                                                <filemode>644</filemode>
                                            </mapper>
                                        </data>
                                    </dataSet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>rpm-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>transport-rpm</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>attached-rpm</goal>
                                </goals>
                                <configuration>
                                <name>${transport.name}</name>
                                <version>0.5.1</version>
                                <release>${rpm.release}</release>
                                <license>GPL-3.0-or-later</license>
                                <group>Applications/Communications</group>
                                <summary>The Matrix transport for Porelo</summary>
                                <description>Carries messages Porelo's filter let through into a project's Matrix room, and brings the room's messages back into a task's mailbox.</description>
                                <url>https://github.com/porelo-ai/porelo-message-matrix</url>
                                <needarch>x86_64</needarch>
                                <!-- What the new-machine wizard offers as a transport. -->
                                <provides>
                                    <provide>porelo-transport</provide>
                                </provides>
                                <!-- Porelo sends nothing without the filter; required here, a person never meets that. -->
                                <requires>
                                    <require>porelo</require>
                                    <require>porelo-message-sluice-filter</require>
                                    <require>libc.so.6(GLIBC_${matrix.glibc.floor})(64bit)</require>
                                    <require>libz.so.1(ZLIB_${matrix.zlib.floor})(64bit)</require>
                                </requires>
                                <defaultUsername>root</defaultUsername>
                                <defaultGroupname>root</defaultGroupname>
                                <mappings>
                                    <mapping>
                                        <directory>/usr/libexec/porelo/transports</directory>
                                        <directoryIncluded>false</directoryIncluded>
                                        <filemode>755</filemode>
                                        <sources>
                                            <source>
                                                <location>${project.build.directory}/${transport.name}</location>
                                            </source>
                                        </sources>
                                    </mapping>
                                    <!-- The directory on its own: a mapping with files gives its directory the files' mode. -->
                                    <mapping>
                                        <directory>${package.doc}</directory>
                                        <filemode>755</filemode>
                                    </mapping>
                                    <mapping>
                                        <directory>${package.doc}</directory>
                                        <directoryIncluded>false</directoryIncluded>
                                        <filemode>644</filemode>
                                        <documentation>true</documentation>
                                        <sources>
                                            <source>
                                                <location>${project.build.directory}/sbom.cdx.json</location>
                                            </source>
                                            <source>
                                                <location>${project.basedir}/LICENSE</location>
                                            </source>
                                        </sources>
                                    </mapping>
                                </mappings>
                            </configuration>
                            </execution>
                            <execution>
                                <id>homeserver-rpm</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>attached-rpm</goal>
                                </goals>
                                <configuration>
                                    <name>${homeserver.name}</name>
                                    <classifier>homeserver</classifier>
                                    <version>0.5.1</version>
                                    <release>${rpm.release}</release>
                                    <license>GPL-3.0-or-later</license>
                                    <group>Applications/Communications</group>
                                    <summary>The local Matrix homeserver for Porelo's transport</summary>
                                    <description>A systemd user unit that runs the homeserver Porelo's Matrix transport talks to, in rootless podman, on loopback only, for the account that enables it.</description>
                                    <url>https://github.com/porelo-ai/porelo-message-matrix</url>
                                    <needarch>noarch</needarch>
                                    <!-- How a machine's setup knows to offer it beside the transport: it is chosen, never pulled in. -->
                                    <provides>
                                        <provide>porelo-homeserver</provide>
                                    </provides>
                                    <requires>
                                        <require>${transport.name}</require>
                                        <require>podman</require>
                                    </requires>
                                    <defaultUsername>root</defaultUsername>
                                    <defaultGroupname>root</defaultGroupname>
                                    <mappings>
                                        <mapping>
                                            <directory>/usr/lib/systemd/user</directory>
                                            <directoryIncluded>false</directoryIncluded>
                                            <filemode>644</filemode>
                                            <sources>
                                                <source>
                                                    <location>${homeserver.unit}</location>
                                                </source>
                                            </sources>
                                        </mapping>
                                        <mapping>
                                            <directory>/usr/share/doc/${homeserver.name}</directory>
                                            <filemode>755</filemode>
                                        </mapping>
                                        <mapping>
                                            <directory>/usr/share/doc/${homeserver.name}</directory>
                                            <directoryIncluded>false</directoryIncluded>
                                            <filemode>644</filemode>
                                            <documentation>true</documentation>
                                            <sources>
                                                <source>
                                                    <location>${project.basedir}/LICENSE</location>
                                                </source>
                                            </sources>
                                        </mapping>
                                    </mappings>
                                </configuration>
                            </execution>
                        </executions>
                        </plugin>
                    <!-- The integration tests run the executable itself, as Porelo does, not the classes in this JVM. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <transport.executable>${transport.executable}</transport.executable>
                                <!-- The raw parts a package's version is made of, so a test can work it out
                                     itself rather than read back deb.version or rpm.release. -->
                                <porelo.snapshot.run>${porelo.snapshot.run}</porelo.snapshot.run>
                                <porelo.snapshot.suffix>${porelo.snapshot.suffix}</porelo.snapshot.suffix>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- A change to documents or issues: only the tests that read them, tagged so. -->
            <id>documents</id>
            <properties>
                <groups>documents</groups>
            </properties>
        </profile>
    </profiles>
</project>
